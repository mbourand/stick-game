# ---- Build stage: build apps/front in the pnpm/turbo monorepo ----
FROM node:22-alpine AS build
WORKDIR /app

# Enable pnpm via corepack (version pinned by package.json "packageManager")
RUN corepack enable

# Copy lockfile + workspace manifests first for better layer caching.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY turbo.json tsconfig.base.json tsconfig.json ./

# Copy the workspaces the front build needs (front + its workspace deps).
COPY apps ./apps
COPY packages ./packages
COPY tools ./tools

# Install all workspace deps (frozen to the lockfile) and build the front.
RUN pnpm install --frozen-lockfile
RUN pnpm front:build:production

# ---- Runtime stage: serve the static dist with NGINX ----
FROM nginx:1.27-alpine AS runtime

# SPA-aware NGINX config (catch-all -> index.html).
COPY nginx.front.conf /etc/nginx/conf.d/default.conf

# Runtime env injection: nginx:alpine auto-runs executable scripts in
# /docker-entrypoint.d/ before starting. The script reads every VITE_* env
# var and writes env-config.js — no per-var config anywhere in the image.
COPY docker/front-entrypoint.sh /docker-entrypoint.d/40-front-env-config.sh
RUN chmod +x /docker-entrypoint.d/40-front-env-config.sh

# Built assets.
COPY --from=build /app/apps/front/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
