# Server configuration
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Auth configuration
# Random secret used to sign session JWTs (>=16 chars).
AUTH_JWT_SECRET=<random_long_secret>
# Public base URL of THIS backend (with the /api prefix); builds OAuth callbacks.
# Production: https://tau.mbourand.fr/api
AUTH_PUBLIC_BACKEND_URL=http://localhost:3001/api
# OAuth app credentials. A provider is only offered once both id+secret are set.
# Discord app: https://discord.com/developers/applications
#   Redirect URI: <AUTH_PUBLIC_BACKEND_URL>/auth/discord/callback
DISCORD_CLIENT_ID=<your_discord_app_client_id>
DISCORD_CLIENT_SECRET=<your_discord_app_client_secret>
# Google OAuth client: https://console.cloud.google.com/apis/credentials
#   Redirect URI: <AUTH_PUBLIC_BACKEND_URL>/auth/google/callback
GOOGLE_CLIENT_ID=<your_google_oauth_client_id>
GOOGLE_CLIENT_SECRET=<your_google_oauth_client_secret>

# osu! api configuration
OSU_API_BASE_URL=https://osu.ppy.sh/api/v2
OSU_OAUTH_TOKEN_URL=https://osu.ppy.sh/oauth/token
OSU_CLIENT_ID=<your_osu_oauth_app_client_id>
OSU_CLIENT_SECRET=<your_osu_oauth_app_client_secret>

# Database configuration
DATABASE_URL="postgres://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>"
