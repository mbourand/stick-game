// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Score {
  id             Int      @id @default(autoincrement())
  player         User?    @relation(fields: [playerId], references: [id])
  playerId       String?
  playerName     String
  beatmapId      String
  score          Int
  maxCombo       Int
  accuracy       Float
  missCount      Int
  mehCount       Int
  goodCount      Int
  greatCount     Int
  perfectCount   Int
  submissionTime DateTime @default(now())
  scoreVersion   Int
}

model User {
  id                   String   @id @default(uuid())
  username             String   @unique
  email                String   @unique
  isEmailVerified      Boolean  @default(false)
  hashedPassword       String
  totalScore           Int      @default(0)
  totalSubmittedScores Int      @default(0)
  accuracySum          Float    @default(0)
  performancePoints    Int      @default(0)
  ssCount              Int      @default(0)
  fullComboCount       Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  scores               Score[]
}
