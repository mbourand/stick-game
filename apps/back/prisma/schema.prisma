// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Score {
  playerName     String
  beatmapId      String
  score          Int
  maxCombo       Int
  accuracy       Float
  missCount      Int
  mehCount       Int
  goodCount      Int
  greatCount     Int
  perfectCount   Int
  submissionTime DateTime @default(now())
  scoreVersion   Int

  @@id([playerName, beatmapId, scoreVersion])
}
