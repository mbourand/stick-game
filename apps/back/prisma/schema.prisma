// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/prisma/generated/client"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../src/prisma/generated/zod"
  config   = "./zod-generator.config.json"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DailyFeature {
  /// UTC day this pick is valid for, formatted YYYY-MM-DD.
  date         String   @id
  beatmapsetId Int
  /// Full GetOsuDailyResponse payload, so we can serve the same pick after a
  /// restart without re-querying osu! (validated against the Zod schema on read).
  payload      Json
  featuredAt   DateTime @default(now())
}

model Score {
  /// @zod.string().min(1).max(32)
  playerName      String
  /// @zod.string().min(1).max(32)
  beatmapId       String
  /// @zod.number().int().nonnegative()
  score           Int
  /// @zod.number().int().nonnegative()
  maxCombo        Int
  /// @zod.number().nonnegative()
  accuracy        Float
  /// @zod.number().int().nonnegative()
  missCount       Int
  /// @zod.number().int().nonnegative()
  mehCount        Int
  /// @zod.number().int().nonnegative()
  goodCount       Int
  /// @zod.number().int().nonnegative()
  greatCount      Int
  /// @zod.number().int().nonnegative()
  perfectCount    Int
  submissionTime  DateTime @default(now())
  /// @zod.number().int().nonnegative()
  scoreVersion    Int
  /// Whether the play used mods — splits the modded board from the no-mods board.
  modded          Boolean  @default(false)
  /// @zod.string().max(64)
  /// Human-readable mod summary (e.g. "Rate ×1.50"); "" for no-mods plays.
  mods            String   @default("")

  @@id([playerName, beatmapId, scoreVersion, modded])
}
