generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Score {
  playerName     String
  beatmapId      String
  score          Int
  maxCombo       Int
  accuracy       Float
  missCount      Int
  mehCount       Int
  goodCount      Int
  greatCount     Int
  perfectCount   Int
  submissionTime DateTime @default(now())
  scoreVersion   Int

  @@id([playerName, beatmapId, scoreVersion])
}

model User {
  /// @zod.string().uuid()
  id String @id @default(uuid())
  /// @zod.string().min(1).max(32)
  username String @unique
  /// @zod.string().email()
  email String @unique
  /// @zod.boolean()
  isEmailVerified Boolean @default(false)
  /// @zod.string()
  hashedPassword String
  /// @zod.number().int().nonnegative()
  totalScore Int @default(0)
  /// @zod.number().int().nonnegative()
  totalSubmittedScores Int @default(0)
  /// @zod.number().nonnegative()
  accuracySum Float @default(0)
  /// @zod.number().int().nonnegative()
  performancePoints Int @default(0)
  /// @zod.number().int().nonnegative()
  ssCount Int @default(0)
  // @zod.number().int().nonnegative()
  fullComboCount Int @default(0)
  /// @zod.date()
  createdAt DateTime @default(now())
  /// @zod.date()
  updatedAt DateTime @updatedAt
}
