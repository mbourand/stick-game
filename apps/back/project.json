{
  "name": "@tau/back",
  "targets": {
    "migrate-prod-db": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn prisma migrate deploy",
        "cwd": "{projectRoot}"
      }
    },
    "generate-prisma-schemas": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn prisma generate",
        "cwd": "{projectRoot}"
      }
    }
  }
}
