{
  "name": "@tau/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "generate": "turbo run generate",
    "format": "prettier --write .",
    "front:build:production": "pnpm --filter @tau/front run build",
    "front:start:production": "pnpm --filter @tau/front run start",
    "back:build:production": "pnpm --filter @tau/back run build",
    "back:start:production": "pnpm --filter @tau/back run start:prod",
    "docker:up:dev": "docker compose -f docker-compose.dev.yml up --force-recreate --build -d",
    "docker:down:dev": "docker compose -f docker-compose.dev.yml down -v"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.38.0",
    "@next/eslint-plugin-next": "^15.5.18",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.38.0",
    "eslint-config-next": "^15.5.18",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.2.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "jsonc-eslint-parser": "^2.4.1",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "turbo": "^2.9.14",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.45.0"
  },
  "pnpm": {
    "overrides": {
      "prisma-zod-generator>@prisma/internals": "6.19.3"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "prisma",
      "prisma-zod-generator",
      "sharp",
      "unrs-resolver"
    ]
  }
}
