{
  "name": "@tau/back-schemas",
  "implicitDependencies": ["@tau/back"],
  "targets": {
    "generate-openapi-schemas": {
      "executor": "@tau/generate-openapi-schemas:zod",
      "inputs": ["{projectRoot}/openapi.json"],
      "outputs": ["{projectRoot}/src"],
      "options": {
        "specPath": "{projectRoot}/openapi.json",
        "outputPath": "{workspaceRoot}/packages/api-schemas/back-schemas/src/lib"
      }
    }
  }
}
